EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Web-only base URL for email confirmation when using Expo web.
# Native / Expo Go ignores this and uses bloodlink:// or exp:// deep links instead.
# Also allow these in Supabase Auth → URL Configuration → Redirect URLs:
#   http://localhost:8081/**
#   bloodlink://**
#   exp://**
# Site URL should be http://localhost:8081 (not :3000).
EXPO_PUBLIC_AUTH_REDIRECT_URL=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org
EXPO_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
EXPO_PUBLIC_OSM_USER_AGENT=BloodLink/1.0 your-email@example.com

# Native Google Sign-In (in-app account picker). Web client ID is required for ID tokens.
# Create OAuth clients in Google Cloud Console, then enable Google in Supabase Auth.
# Android also needs an Android OAuth client (package com.sevenerr.BloodLink + SHA-1 of the
# signing key for your development/production build — use `eas credentials -p android`).
# Optional: store the Android client ID here for reference (not passed to GoogleSignin.configure).
# iOS: set ios client ID + reversed client ID as EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME
#   (com.googleusercontent.apps.XXXX). Enable "Skip nonce check" in Supabase Google provider for iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# MapLibre street style (OpenFreeMap / OpenStreetMap data — no API key required)
EXPO_PUBLIC_MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Satellite imagery (Esri; OSM has no official satellite layer)
EXPO_PUBLIC_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Backend-only email settings. Do not expose these with EXPO_PUBLIC_.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BloodLink <no-reply@example.com>

# SMS API Philippines (https://smsapiph.netlify.app) - Supabase Edge Function secrets
# Set via: npx supabase secrets set --project-ref <ref> SMS_API_KEY=sk-... SMS_API_URL=https://smsapiph.onrender.com/api/v1/send/sms
# Also set SEND_SMS_HOOK_SECRET from Supabase Authentication > Hooks > Send SMS.
SMS_API_KEY=
SMS_API_URL=https://smsapiph.onrender.com/api/v1/send/sms
SEND_SMS_HOOK_SECRET=

# MensaHero SMS (Optional Fallback)
MENSAHERO_API_KEY=
MENSAHERO_DEVICE_NAME=
MENSAHERO_API_URL=https://mensahero.onrender.com/api/messages/create

# Backend-only Hemie AI settings (server/.env). Do not expose with EXPO_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
HEMIE_LLM_API_KEY=
HEMIE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
HEMIE_LLM_MODEL=gemini-3.5-flash-lite
HEMIE_LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.6-flash
HEMIE_RATE_LIMIT_MAX=40
HEMIE_RATE_LIMIT_WINDOW_MS=60000
